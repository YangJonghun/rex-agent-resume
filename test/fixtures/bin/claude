#!/usr/bin/env python3
import json, os, subprocess, sys, time

args = sys.argv[1:]
session = args[args.index("--resume") + 1] if "--resume" in args else "c%d" % os.getpid()
transcript = "%s/.claude/projects/-e2e/%s.jsonl" % (os.environ["E2E_HOME"], session)
if not os.path.exists(transcript):
    os.makedirs(os.path.dirname(transcript), exist_ok=True)
    with open(transcript, "w") as f:
        for record in [
            {"type": "user", "permissionMode": "default"},
            {"type": "assistant", "effort": "xhigh", "isSidechain": False},
            {"type": "permission-mode", "permissionMode": "bypassPermissions"},
        ]:
            f.write(json.dumps(record, separators=(",", ":")) + "\n")
payload = json.dumps({"hook_event_name": "SessionStart", "session_id": session, "transcript_path": transcript,
                      "source": "resume" if "--resume" in args else "startup"})
subprocess.run([os.environ["E2E_HOOK"], "claude"], input=payload.encode())
while True:
    time.sleep(3600)
